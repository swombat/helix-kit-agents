#!/usr/bin/env python3
"""
generate-env — decrypt credentials.yml.enc with master.key, compose .env file.

Runs on the deploy host (or locally during testing). Reads:
  - master.key (one-line base64 of 32 random bytes)
  - credentials.yml.enc (AES-256-GCM-encrypted credentials YAML)
  - deploy.yml (image tag, identity path, memory limits, optional provider/model)
  - host environment variables (LLM provider keys: ANTHROPIC_API_KEY etc.)

Writes:
  - .env (plaintext, mode 0600, gitignored)

Format spec for credentials.yml.enc:

    # comment lines allowed
    algorithm: aes-256-gcm
    nonce: <base64 12-byte nonce>
    ciphertext: <base64 (ciphertext + 16-byte AES-GCM tag)>
    helix_kit_signature: <hex sha256-hmac of plaintext>   # optional, not verified here

The plaintext is YAML with this shape:

    agent_id: wing
    agent_uuid: 7a2c89e5-...
    helix_kit:
      app_url: https://...
      mcp_url: https://...
      bearer_token: hx_...
    trigger:
      bearer_token: tr_...

Usage:
    bin/generate-env [--master-key-file PATH] [--credentials PATH] [--out .env]

Defaults are repo-relative or /etc/helix-kit-agents/<agent_id>/master.key
when run on the deploy host (the host_master_key path is tried as a fallback).
"""

import argparse
import base64
import os
import sys
from pathlib import Path

import yaml
from cryptography.hazmat.primitives.ciphers.aead import AESGCM


REPO_ROOT = Path(__file__).resolve().parent.parent


def decrypt_credentials(master_key_b64: str, encrypted_yaml: str) -> dict:
    """Decrypt the credentials.yml.enc content. Returns the plaintext YAML as a dict."""
    blob = yaml.safe_load(encrypted_yaml)
    if not blob or "algorithm" not in blob:
        raise ValueError("credentials.yml.enc is malformed (missing 'algorithm')")
    if blob["algorithm"] != "aes-256-gcm":
        raise ValueError(f"unsupported algorithm: {blob['algorithm']}")

    try:
        master_key = base64.b64decode(master_key_b64.strip())
    except Exception as e:
        raise ValueError(f"master key is not valid base64: {e}")
    if len(master_key) != 32:
        raise ValueError(f"master key must decode to 32 bytes (got {len(master_key)})")

    nonce = base64.b64decode(blob["nonce"])
    ct_and_tag = base64.b64decode(blob["ciphertext"])
    if len(nonce) != 12:
        raise ValueError(f"nonce must be 12 bytes (got {len(nonce)})")

    try:
        plaintext = AESGCM(master_key).decrypt(nonce, ct_and_tag, None)
    except Exception as e:
        raise ValueError(
            f"decryption failed — the master key probably doesn't match this encrypted file. ({e})"
        )

    creds = yaml.safe_load(plaintext)
    if not isinstance(creds, dict):
        raise ValueError("decrypted credentials are not a YAML mapping")
    return creds


def find_master_key(args) -> str:
    """Locate the master key, preferring explicit --master-key-file, then conventional paths."""
    if args.master_key_file:
        path = Path(args.master_key_file)
    elif (REPO_ROOT / "master.key").exists():
        path = REPO_ROOT / "master.key"
    else:
        # Try the deploy-host conventional location, requires deploy.yml to know the agent_id
        deploy = load_deploy_yml(args)
        agent_id = deploy.get("agent_id")
        if not agent_id:
            raise SystemExit(
                "no --master-key-file given, master.key not in repo root, and "
                "deploy.yml has no agent_id to derive a host path. Aborting."
            )
        path = Path(f"/etc/helix-kit-agents/{agent_id}/master.key")

    if not path.exists():
        raise SystemExit(f"master key not found at: {path}")
    if not os.access(path, os.R_OK):
        raise SystemExit(f"master key not readable at: {path}")
    return path.read_text()


def load_credentials_enc(args) -> str:
    path = Path(args.credentials) if args.credentials else REPO_ROOT / "credentials.yml.enc"
    if not path.exists():
        raise SystemExit(f"credentials file not found at: {path}")
    return path.read_text()


def load_deploy_yml(args) -> dict:
    path = Path(args.deploy_yml) if args.deploy_yml else REPO_ROOT / "deploy.yml"
    if not path.exists():
        # deploy.yml is optional for the credentials-only path (e.g. tests); fall through with empty
        return {}
    with path.open() as f:
        return yaml.safe_load(f) or {}


def compose_env(creds: dict, deploy: dict) -> str:
    """Compose the .env file content from decrypted creds + deploy.yml + host env."""
    agent_id = creds.get("agent_id") or deploy.get("agent_id")
    if not agent_id:
        raise SystemExit("agent_id missing from both credentials and deploy.yml")

    helix_kit = creds.get("helix_kit", {})
    trigger = creds.get("trigger", {})
    app_url = helix_kit.get("app_url") or helix_kit.get("mcp_url", "")
    if not helix_kit.get("app_url") and helix_kit.get("mcp_url"):
        print(
            "warning: helix_kit.app_url missing from credentials; falling back to helix_kit.mcp_url for REST announce",
            file=sys.stderr,
        )

    lines = [
        "# Generated by bin/generate-env. Do not commit. Do not edit by hand.",
        f"AGENT_ID={agent_id}",
        f"AGENT_UUID={creds.get('agent_uuid', '')}",
        f"AGENT_PROVIDER={deploy.get('provider', 'anthropic')}",
        f"AGENT_DEFAULT_MODEL={deploy.get('default_model', 'claude-haiku-4-5')}",
        f"HELIXKIT_APP_URL={app_url}",
        f"HELIXKIT_MCP_URL={helix_kit.get('mcp_url', '')}",
        f"HELIXKIT_BEARER_TOKEN={helix_kit.get('bearer_token', '')}",
        f"TRIGGER_BEARER_TOKEN={trigger.get('bearer_token', '')}",
        f"IMAGE_TAG={deploy.get('image_tag', 'latest')}",
        f"IDENTITY_PATH={deploy.get('identity_path', f'/var/lib/agents/{agent_id}/identity')}",
        f"SHIM_PORT={deploy.get('shim_port', 4000)}",
        f"MEM_LIMIT={deploy.get('mem_limit', '8g')}",
    ]

    # Pass through LLM provider keys from host env. We don't validate them; the
    # container will fail loudly if AGENT_PROVIDER is set to a provider whose
    # key wasn't supplied.
    for key in ("ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GROK_API_KEY", "GOOGLE_API_KEY"):
        if key in os.environ:
            lines.append(f"{key}={os.environ[key]}")

    return "\n".join(lines) + "\n"


def write_env(content: str, out_path: Path) -> None:
    """Write atomically with mode 0600. Skip write if content is unchanged."""
    if out_path.exists() and out_path.read_text() == content:
        print(f"{out_path} unchanged.")
        return
    tmp = out_path.with_suffix(out_path.suffix + ".tmp")
    tmp.write_text(content)
    os.chmod(tmp, 0o600)
    tmp.replace(out_path)
    print(f"wrote {out_path} (mode 0600).")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument("--master-key-file", help="path to master.key (default: tries repo root, then /etc/helix-kit-agents/<agent_id>/master.key)")
    parser.add_argument("--credentials", help="path to credentials.yml.enc (default: repo root)")
    parser.add_argument("--deploy-yml", help="path to deploy.yml (default: repo root)")
    parser.add_argument("--out", default=str(REPO_ROOT / ".env"), help="output .env path")
    args = parser.parse_args()

    try:
        master_key = find_master_key(args)
        encrypted = load_credentials_enc(args)
        creds = decrypt_credentials(master_key, encrypted)
        deploy = load_deploy_yml(args)
        env_content = compose_env(creds, deploy)
        write_env(env_content, Path(args.out))
    except (ValueError, SystemExit) as e:
        if isinstance(e, SystemExit):
            raise
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
