#!/usr/bin/env python3
"""
undeploy — stop the agent's container. Optionally archive identity/.

Does NOT delete data on the deploy host (the chaos-home volume + identity/
remain). Re-running bin/deploy will bring it back up exactly where it was.

To completely remove an agent's data on the host, see docs/deploy.md.
"""

import argparse
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime
from pathlib import Path

import yaml

REPO_ROOT = Path(__file__).resolve().parent.parent


def ssh(host: str, cmd: str):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", host, cmd], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument("--host", help="SSH hostname (omit to operate on local Docker)")
    parser.add_argument("--archive-identity", action="store_true",
                        help="tar.gz the identity/ folder before stopping")
    args = parser.parse_args()

    deploy_yml = REPO_ROOT / "deploy.yml"
    if not deploy_yml.exists():
        print(f"error: missing {deploy_yml}", file=sys.stderr)
        sys.exit(1)

    with deploy_yml.open() as f:
        deploy = yaml.safe_load(f) or {}
    agent_id = deploy.get("agent_id")
    if not agent_id:
        print("error: deploy.yml needs agent_id", file=sys.stderr)
        sys.exit(1)

    if args.archive_identity:
        ts = datetime.utcnow().strftime("%Y%m%d-%H%M%S")
        archive_path = REPO_ROOT / f"identity-archive-{ts}.tar.gz"
        print(f"archiving identity/ → {archive_path}")
        with tarfile.open(archive_path, "w:gz") as tf:
            tf.add(REPO_ROOT / "identity", arcname="identity")

    repo_dir = deploy.get("host_repo_path", f"/var/lib/agents/{agent_id}")
    print(f"stopping agent-{agent_id}")
    if args.host:
        ssh(args.host, f"cd {repo_dir} && docker compose -p agent-{agent_id} down")
    else:
        subprocess.run(
            ["docker", "compose", "-f", "docker-compose.yml.template",
             "-p", f"agent-{agent_id}", "down"],
            cwd=REPO_ROOT, check=True,
        )

    print(f"agent-{agent_id} stopped. Data on the host (chaos-home volume, identity/) remains.")


if __name__ == "__main__":
    main()
