# credentials.yml.enc.example
#
# This is a placeholder. The real credentials.yml.enc is generated by
# HelixKit's promote wizard — it contains your agent's bearer tokens
# encrypted with the master key shown to you once during the wizard.
#
# To use:
#   1. Run the promote wizard in HelixKit for your agent
#   2. Save the encrypted blob it shows you as `credentials.yml.enc` in this
#      repo's root (replacing this file)
#   3. Save the master key it shows you on your deploy host at
#      /etc/helix-kit-agents/<agent_id>/master.key (mode 0600)
#   4. Run bin/deploy
#
# DO NOT edit this file by hand. The format is below for reference only.

algorithm: aes-256-gcm
nonce: <base64 12-byte nonce, generated by HelixKit>
ciphertext: <base64 ciphertext + 16-byte AES-GCM auth tag>
helix_kit_signature: <hex sha256-hmac, optional integrity check>
