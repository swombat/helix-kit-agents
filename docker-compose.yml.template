# docker-compose.yml.template
#
# Used by bin/deploy. Variables come from the .env file produced by bin/generate-env
# (which decrypts credentials.yml.enc with master.key and merges with the host's
# LLM provider env vars).
#
# Do NOT commit a `.env` file alongside this template — it contains plaintext
# bearer tokens. .env is gitignored.

services:
  agent:
    image: helix-kit-agents:${IMAGE_TAG:-latest}
    build:
      context: .
      dockerfile: Dockerfile
    container_name: agent-${AGENT_ID:?set AGENT_ID in .env}
    restart: unless-stopped

    ports:
      - "${SHIM_PORT:-4000}:4000"

    environment:
      AGENT_ID: ${AGENT_ID}
      AGENT_PROVIDER: ${AGENT_PROVIDER:-anthropic}
      AGENT_DEFAULT_MODEL: ${AGENT_DEFAULT_MODEL:-claude-haiku-4-5}
      AGENT_REPO_PATH: /home/agent/repo
      AGENT_IDENTITY_PATH: /home/agent/identity

      # Auth tokens — from credentials.yml.enc, decrypted at deploy time
      TRIGGER_BEARER_TOKEN: ${TRIGGER_BEARER_TOKEN:?set TRIGGER_BEARER_TOKEN}
      HELIXKIT_BEARER_TOKEN: ${HELIXKIT_BEARER_TOKEN:?set HELIXKIT_BEARER_TOKEN}
      HELIXKIT_APP_URL: ${HELIXKIT_APP_URL:?set HELIXKIT_APP_URL}
      GIT_SSH_COMMAND: ssh -i /run/agent-deploy-key -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null

      # User-supplied LLM provider key — from host env, never enters the repo
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      # Add other provider keys as needed; all are optional, the agent will
      # use whichever one matches AGENT_PROVIDER.

    volumes:
      # Persist chaos session/config across restarts (agent's home dir for chaos data)
      - chaos-home:/home/agent/.chaos

      # Agent repo working tree — bind-mounted from the deploy host. Contains
      # identity/ and .git so the agent can commit and push identity changes.
      - ${REPO_PATH:?set REPO_PATH}:/home/agent/repo

      # Deploy key — decrypted from credentials.yml.enc by bin/generate-env.
      - ${AGENT_DEPLOY_KEY_PATH:-/dev/null}:/run/agent-deploy-key:ro

    extra_hosts:
      # On Linux, ensures host.docker.internal resolves (useful for local dev
      # where the agent talks back to a HelixKit instance on the host)
      - "host.docker.internal:host-gateway"

    mem_limit: ${MEM_LIMIT:-8g}

volumes:
  chaos-home:
    name: agent-${AGENT_ID}-home
